start: scene

scene: "scene" NAME statement*

statement: object
         | component
         | instance
         | repeat
         | import_stmt

import_stmt: "import" ESCAPED_STRING

object: block
      | marker
      | wedge
      | cylinder
      | frustum
      | hollow_frustum
      | hollow_pipe_arc
      | ring
      | spherical_cap
      | pipe_arc
      | profile_revolve

block: "block" NAME property*

marker: "marker" NAME marker_property*

wedge: "wedge" NAME property*

cylinder: "cylinder" NAME property*

frustum: "frustum" NAME property*

hollow_frustum: "hollowFrustum" NAME property*

hollow_pipe_arc: "hollowPipeArc" NAME property*

ring: "ring" NAME property*

spherical_cap: "sphericalCap" NAME property*

pipe_arc: "pipeArc" NAME property*

profile_revolve: "profileRevolve" NAME profile_revolve_statement*

profile_revolve_statement: property
                         | profile
                         | thickness

profile: "profile" profile_point+

profile_point: "point" expression expression

thickness: "thickness" expression

component: "component" NAME component_statement*

component_statement: param
                   | object
                   | instance
                   | repeat
                   | mesh
                   | runtime_asset

runtime_asset: "runtime_asset" NAME

mesh: "mesh" NAME mesh_statement* "endmesh"

mesh_statement: object
              | instance
              | at
              | rotate

param: "param" NAME expression

instance: "instance" NAME NAME instance_property*

repeat: "repeat" NAME NAME repeat_property*

repeat_property: instance_property
               | count
               | step

count: "count" expression

step: "step" expression expression expression

instance_property: at
                 | rotate
                 | scale
                 | mirror
                 | emissive
                 | set_param

set_param: "set" NAME expression

property: at
        | size
        | radius
        | radius_inner
        | radius_outer
        | radius_top
        | radius_bottom
        | outer_bottom_radius
        | outer_top_radius
        | inner_bottom_radius
        | inner_top_radius
        | outer_radius
        | inner_radius
        | start_angle
        | cross_start_angle
        | cross_angle
        | base_radius
        | pipe_radius
        | bend_radius
        | angle
        | height
        | segments
        | anchor
        | rotate
        | color
        | material
        | transparency
        | emissive

marker_property: at
               | rotate

at: "at" expression expression expression

size: "size" expression expression expression

radius: "radius" expression

radius_inner: "radius_inner" expression

radius_outer: "radius_outer" expression

radius_top: "radius_top" expression

radius_bottom: "radius_bottom" expression

outer_bottom_radius: "outerBottomRadius" expression

outer_top_radius: "outerTopRadius" expression

inner_bottom_radius: "innerBottomRadius" expression

inner_top_radius: "innerTopRadius" expression

outer_radius: "outerRadius" expression

inner_radius: "innerRadius" expression

start_angle: "start_angle" expression
           | "startAngle" expression

cross_start_angle: "crossStartAngle" expression

cross_angle: "crossAngle" expression

base_radius: "baseRadius" expression

pipe_radius: "pipeRadius" expression

bend_radius: "bendRadius" expression

angle: "angle" expression

height: "height" expression

segments: "segments" expression

anchor: "anchor" NAME NAME NAME

rotate: "rotate" expression expression expression

scale: "scale" expression

mirror: "mirror" NAME

color: "color" COLOR

material: "material" NAME

transparency: "transparency" expression

emissive: "emissive" expression

?expression: sum

?sum: sum "+" product   -> add
    | sum "-" product   -> sub
    | product

?product: product "*" unary  -> mul
        | product "/" unary  -> div
        | unary

?unary: "-" unary            -> neg
      | atom

?atom: NUMBER                -> number
     | NAME                  -> variable
     | "(" expression ")"

NAME: /[A-Za-z_][A-Za-z0-9_]*/

COLOR: /#[0-9a-fA-F]{6}|[A-Za-z_][A-Za-z0-9_]*/

NUMBER: /-?\d+(\.\d+)?/
COMMENT: /#(?![0-9a-fA-F]{6}\b)[^\n]*/

%import common.WS
%import common.ESCAPED_STRING
%ignore WS
%ignore COMMENT
